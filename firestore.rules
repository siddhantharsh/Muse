rules_version = '2';

// ============================================================
// Muse — Firestore Security Rules
// Each signed-in person can read and write exactly one document,
// users/{their uid}, holding their synced app state. Nothing else
// in the database is reachable from the client.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidState() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'updatedAt', 'deviceId', 'schema'])
        && d.data is string
        && d.data.size() < 1000000
        && d.updatedAt is int
        && d.deviceId is string
        && d.schema is int;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidState();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
